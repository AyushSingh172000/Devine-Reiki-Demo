# Divine Reiki Website - Apache Configuration & URL Rewrites
RewriteEngine On

# Clean trailing slash redirect for directories using REQUEST_URI
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]

# Redirect index.php/admin to admin login screen
RewriteCond %{REQUEST_URI} ^/(.+?)/index\.php/admin/?$ [NC]
RewriteRule ^index\.php/admin/?$ /%1/admin/login [R=302,L]

# Force HTTPS on live hosting (auto-skipped on localhost development)
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# -------------------------------------------------------------
# 1. External Redirects: Remove .php from URL in browser address bar
# -------------------------------------------------------------

# Redirect index.php (in root or subfolders like admin/) to directory root (/)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/index\.php([?\s].*)?$ [NC]
RewriteRule ^(.*)index\.php$ %1/ [R=301,L]

# Redirect detail pages with query parameter to clean path (e.g. /service-detail.php?slug=xxx -> /service/xxx)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/service-detail\.php\?slug=([a-zA-Z0-9_-]+) [NC]
RewriteRule ^ %1/service/%2? [R=301,L]

RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/course-detail\.php\?slug=([a-zA-Z0-9_-]+) [NC]
RewriteRule ^ %1/course/%2? [R=301,L]

RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/product-detail\.php\?slug=([a-zA-Z0-9_-]+) [NC]
RewriteRule ^ %1/product/%2? [R=301,L]

RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/blog-detail\.php\?slug=([a-zA-Z0-9_-]+) [NC]
RewriteRule ^ %1/blog/%2? [R=301,L]

# Redirect direct requests for any other .php file to clean extensionless URL (e.g. /services.php -> /services, /admin/login.php -> /admin/login)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# -------------------------------------------------------------
# 2. Internal Rewrites: Map clean URLs back to PHP files
# -------------------------------------------------------------

# Service Detail Clean URLs
RewriteRule ^service/([a-zA-Z0-9-]+)/?$ service-detail.php?slug=$1 [QSA,L]
RewriteRule ^services/?$ services.php [QSA,L]

# Course Detail Clean URLs
RewriteRule ^course/([a-zA-Z0-9-]+)/?$ course-detail.php?slug=$1 [QSA,L]
RewriteRule ^courses/?$ courses.php [QSA,L]

# Product Detail Clean URLs
RewriteRule ^product/([a-zA-Z0-9-]+)/?$ product-detail.php?slug=$1 [QSA,L]
RewriteRule ^shop/?$ products.php [QSA,L]
RewriteRule ^products/?$ products.php [QSA,L]

# Blog Detail Clean URLs
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog-detail.php?slug=$1 [QSA,L]
RewriteRule ^blog/?$ blog.php [QSA,L]

# Static Page Aliases
RewriteRule ^about/?$ about.php [QSA,L]
RewriteRule ^gallery/?$ gallery.php [QSA,L]
RewriteRule ^contact/?$ contact.php [QSA,L]
RewriteRule ^privacy/?$ privacy.php [QSA,L]
RewriteRule ^terms/?$ terms.php [QSA,L]
RewriteRule ^order-bracelet/?$ order-bracelet.php [QSA,L]
RewriteRule ^custom-bracelet/?$ order-bracelet.php [QSA,L]

# Generic rule: Map any extensionless path to existing .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# Catch-all: If file or directory does not exist, serve custom 404 page
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^.*$ 404.php [L]

# Browser Caching Headers
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
